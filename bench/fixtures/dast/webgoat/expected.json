{
  "tool_under_test": "secscan dast",
  "comparison_tool": "zap-baseline.py (direct)",
  "target": "http://host.docker.internal:<port>/WebGoat/",
  "advisory_db_snapshot": "2026-05-24",
  "image_pinning": {
    "juice_shop": "webgoat/webgoat@sha256:3101bd9e7bcfe122d7ef91e690ef3720de36cc4e86b3d06763a1ddf2e2751a4b",
