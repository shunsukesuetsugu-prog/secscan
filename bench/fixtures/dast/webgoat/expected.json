      "min_severity": "LOW"
    },
    {
      "pluginid": "10020",
      "name": "X-Frame-Options Header",
      "min_severity": "LOW"
    },
    {
      "pluginid": "10021",
      "name": "X-Content-Type-Options Header Missing",
      "min_severity": "LOW"
    },
    {
