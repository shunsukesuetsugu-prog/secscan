      "name": "Cookie without SameSite Attribute",
      "min_severity": "LOW"
    },
    {
      "pluginid": "90004",
      "name": "Cross-Origin-Embedder-Policy Header Missing or Invalid",
      "min_severity": "LOW"
    }
  ]
